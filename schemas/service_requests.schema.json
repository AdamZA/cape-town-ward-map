{
  "$defs": {
    "FieldMeta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor in METHODOLOGY.md",
          "title": "Method"
        },
        "source": {
          "description": "Key into the envelope's `sources`",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "unit",
        "source",
        "method",
        "description"
      ],
      "title": "FieldMeta",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ward_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for gaps that apply to the whole dataset",
          "title": "Ward No"
        }
      },
      "required": [
        "code",
        "message",
        "ward_no"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "ServiceRequestRow": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "median_censored": {
          "default": false,
          "description": "True when fewer than half are closed: the median is 'more than' this",
          "title": "Median Censored",
          "type": "boolean"
        },
        "median_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Days"
        },
        "p80_censored": {
          "default": false,
          "title": "P80 Censored",
          "type": "boolean"
        },
        "p80_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P80 Days"
        },
        "pct_closed_30d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct Closed 30D"
        },
        "pct_located": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated share of this area's requests that have a usable location (unlocated requests are attributed via their suburb)",
          "title": "Pct Located"
        },
        "pct_no_completion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of cohort requests with no completion date recorded at as_of",
          "title": "Pct No Completion"
        },
        "per_1000": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cohort requests per 1,000 residents per year",
          "title": "Per 1000"
        },
        "requests": {
          "description": "Located requests created in the cohort period",
          "title": "Requests",
          "type": "integer"
        },
        "ward_no": {
          "title": "Ward No",
          "type": "integer"
        }
      },
      "required": [
        "ward_no",
        "requests",
        "per_1000",
        "median_days",
        "median_censored",
        "p80_days",
        "p80_censored",
        "pct_closed_30d",
        "pct_no_completion",
        "pct_located",
        "flags"
      ],
      "title": "ServiceRequestRow",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "description": "ISO date the data was retrieved",
          "title": "Retrieved At",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "retrieved_at",
        "licence",
        "notes"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "description": "ISO date (or year-month) the figures describe, not when the file was built",
      "title": "As Of",
      "type": "string"
    },
    "citywide": {
      "$ref": "#/$defs/ServiceRequestRow"
    },
    "dataset": {
      "const": "service_requests",
      "default": "service_requests",
      "title": "Dataset",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldMeta"
      },
      "title": "Fields",
      "type": "object"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ServiceRequestRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "object"
    },
    "ward_vintage": {
      "description": "Year the ward delimitation took effect (2021, 2026)",
      "title": "Ward Vintage",
      "type": "integer"
    }
  },
  "required": [
    "dataset",
    "schema_version",
    "ward_vintage",
    "as_of",
    "period",
    "sources",
    "fields",
    "gaps",
    "rows",
    "citywide"
  ],
  "title": "ServiceRequestsEnvelope",
  "type": "object"
}
