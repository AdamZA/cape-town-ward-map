{
  "$defs": {
    "CrimeCategory": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "key",
        "label",
        "note"
      ],
      "title": "CrimeCategory",
      "type": "object"
    },
    "CrimeWardRow": {
      "additionalProperties": false,
      "properties": {
        "precincts": {
          "description": "Largest share first",
          "items": {
            "$ref": "#/$defs/WardPrecinct"
          },
          "title": "Precincts",
          "type": "array"
        },
        "rates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "category -> crimes per 100,000 residents in the covering precinct(s), weighted by where the ward's residents live; latest financial year",
          "title": "Rates",
          "type": "object"
        },
        "ward_no": {
          "title": "Ward No",
          "type": "integer"
        }
      },
      "required": [
        "ward_no",
        "precincts",
        "rates"
      ],
      "title": "CrimeWardRow",
      "type": "object"
    },
    "FieldMeta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor in METHODOLOGY.md",
          "title": "Method"
        },
        "source": {
          "description": "Key into the envelope's `sources`",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "unit",
        "source",
        "method",
        "description"
      ],
      "title": "FieldMeta",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ward_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for gaps that apply to the whole dataset",
          "title": "Ward No"
        }
      },
      "required": [
        "code",
        "message",
        "ward_no"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "description": "ISO date the data was retrieved",
          "title": "Retrieved At",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "retrieved_at",
        "licence",
        "notes"
      ],
      "title": "Source",
      "type": "object"
    },
    "StationCrime": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "description": "category -> financial year -> count",
          "title": "Counts",
          "type": "object"
        },
        "population": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Residents of the precinct (estimate); null where a rate would mislead",
          "title": "Population"
        },
        "station": {
          "title": "Station",
          "type": "string"
        }
      },
      "required": [
        "station",
        "population",
        "counts"
      ],
      "title": "StationCrime",
      "type": "object"
    },
    "WardPrecinct": {
      "additionalProperties": false,
      "properties": {
        "share": {
          "description": "Share of the ward's residents living in this precinct",
          "title": "Share",
          "type": "number"
        },
        "station": {
          "title": "Station",
          "type": "string"
        }
      },
      "required": [
        "station",
        "share"
      ],
      "title": "WardPrecinct",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "description": "ISO date (or year-month) the figures describe, not when the file was built",
      "title": "As Of",
      "type": "string"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/CrimeCategory"
      },
      "title": "Categories",
      "type": "array"
    },
    "city_totals": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "description": "category -> financial year -> count, all City of Cape Town District stations",
      "title": "City Totals",
      "type": "object"
    },
    "dataset": {
      "const": "crime",
      "default": "crime",
      "title": "Dataset",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldMeta"
      },
      "title": "Fields",
      "type": "object"
    },
    "financial_year": {
      "title": "Financial Year",
      "type": "string"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/CrimeWardRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "object"
    },
    "stations": {
      "items": {
        "$ref": "#/$defs/StationCrime"
      },
      "title": "Stations",
      "type": "array"
    },
    "ward_vintage": {
      "description": "Year the ward delimitation took effect (2021, 2026)",
      "title": "Ward Vintage",
      "type": "integer"
    },
    "years": {
      "items": {
        "type": "string"
      },
      "title": "Years",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "schema_version",
    "ward_vintage",
    "as_of",
    "period",
    "sources",
    "fields",
    "gaps",
    "financial_year",
    "years",
    "categories",
    "stations",
    "city_totals",
    "rows"
  ],
  "title": "CrimeEnvelope",
  "type": "object"
}
