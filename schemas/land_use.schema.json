{
  "$defs": {
    "FieldMeta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor in METHODOLOGY.md",
          "title": "Method"
        },
        "source": {
          "description": "Key into the envelope's `sources`",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "unit",
        "source",
        "method",
        "description"
      ],
      "title": "FieldMeta",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ward_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for gaps that apply to the whole dataset",
          "title": "Ward No"
        }
      },
      "required": [
        "code",
        "message",
        "ward_no"
      ],
      "title": "Gap",
      "type": "object"
    },
    "LandUseRow": {
      "additionalProperties": false,
      "properties": {
        "excluded_km2": {
          "description": "Public roads, 'limited use' land and parcels with no zoning recorded",
          "title": "Excluded Km2",
          "type": "number"
        },
        "parcel_coverage": {
          "description": "Share of the ward's area covered by recorded land parcels (can exceed 1 slightly where parcels overlap); low where land is unsurveyed or informally settled",
          "title": "Parcel Coverage",
          "type": "number"
        },
        "shares": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Share of the ward's zoned land per group (keys of `groups`); sums to 1",
          "title": "Shares",
          "type": "object"
        },
        "ward_no": {
          "title": "Ward No",
          "type": "integer"
        },
        "zoned_km2": {
          "description": "Land counted in the shares",
          "title": "Zoned Km2",
          "type": "number"
        }
      },
      "required": [
        "ward_no",
        "shares",
        "zoned_km2",
        "excluded_km2",
        "parcel_coverage"
      ],
      "title": "LandUseRow",
      "type": "object"
    },
    "LandmarkGroup": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "LandmarkGroup",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "description": "ISO date the data was retrieved",
          "title": "Retrieved At",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "retrieved_at",
        "licence",
        "notes"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "description": "ISO date (or year-month) the figures describe, not when the file was built",
      "title": "As Of",
      "type": "string"
    },
    "dataset": {
      "const": "land_use",
      "default": "land_use",
      "title": "Dataset",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldMeta"
      },
      "title": "Fields",
      "type": "object"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "groups": {
      "description": "Land-use groups (keys of `shares`), in order",
      "items": {
        "$ref": "#/$defs/LandmarkGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/LandUseRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "object"
    },
    "ward_vintage": {
      "description": "Year the ward delimitation took effect (2021, 2026)",
      "title": "Ward Vintage",
      "type": "integer"
    }
  },
  "required": [
    "dataset",
    "schema_version",
    "ward_vintage",
    "as_of",
    "period",
    "sources",
    "fields",
    "gaps",
    "groups",
    "rows"
  ],
  "title": "LandUseEnvelope",
  "type": "object"
}
