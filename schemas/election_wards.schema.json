{
  "$defs": {
    "FieldMeta": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anchor in METHODOLOGY.md",
          "title": "Method"
        },
        "source": {
          "description": "Key into the envelope's `sources`",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "unit",
        "source",
        "method",
        "description"
      ],
      "title": "FieldMeta",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ward_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for gaps that apply to the whole dataset",
          "title": "Ward No"
        }
      },
      "required": [
        "code",
        "message",
        "ward_no"
      ],
      "title": "Gap",
      "type": "object"
    },
    "PartyResult": {
      "additionalProperties": false,
      "properties": {
        "party": {
          "title": "Party",
          "type": "string"
        },
        "seats": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Council seats won (municipality rows only)",
          "title": "Seats"
        },
        "share": {
          "description": "Share of valid votes on this ballot, 0-1",
          "title": "Share",
          "type": "number"
        },
        "votes": {
          "title": "Votes",
          "type": "integer"
        }
      },
      "required": [
        "party",
        "votes",
        "share",
        "seats"
      ],
      "title": "PartyResult",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "description": "ISO date the data was retrieved",
          "title": "Retrieved At",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "publisher",
        "url",
        "retrieved_at",
        "licence",
        "notes"
      ],
      "title": "Source",
      "type": "object"
    },
    "WardElectionRow": {
      "additionalProperties": false,
      "properties": {
        "councillor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Elected ward councillor (winning candidate)",
          "title": "Councillor"
        },
        "parties": {
          "description": "Ward ballot, most votes first (up to 8)",
          "items": {
            "$ref": "#/$defs/PartyResult"
          },
          "title": "Parties",
          "type": "array"
        },
        "registered": {
          "title": "Registered",
          "type": "integer"
        },
        "turnout": {
          "description": "Ballots cast / registered on the ward ballot",
          "title": "Turnout",
          "type": "number"
        },
        "ward_no": {
          "title": "Ward No",
          "type": "integer"
        },
        "winner": {
          "description": "Party (or independent) with most ward-ballot votes",
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "ward_no",
        "registered",
        "turnout",
        "winner",
        "councillor",
        "parties"
      ],
      "title": "WardElectionRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "description": "ISO date (or year-month) the figures describe, not when the file was built",
      "title": "As Of",
      "type": "string"
    },
    "dataset": {
      "const": "election_wards",
      "default": "election_wards",
      "title": "Dataset",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/FieldMeta"
      },
      "title": "Fields",
      "type": "object"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "municipality": {
      "title": "Municipality",
      "type": "string"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/WardElectionRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "object"
    },
    "ward_vintage": {
      "description": "Year the ward delimitation took effect (2021, 2026)",
      "title": "Ward Vintage",
      "type": "integer"
    },
    "year": {
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "dataset",
    "schema_version",
    "ward_vintage",
    "as_of",
    "period",
    "sources",
    "fields",
    "gaps",
    "year",
    "municipality",
    "rows"
  ],
  "title": "ElectionWardsEnvelope",
  "type": "object"
}
